<?xml version="1.0" encoding="utf-8"?>
<!-- 6. Selección de sede -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Screen">

    <LinearLayout
        style="@style/Content"
        android:paddingTop="47dp">

        <TextView
            style="@style/Txt.Title"
            android:text="Elige tu sede" />

        <TextView
            style="@style/Txt.Sub"
            android:layout_marginTop="6dp"
            android:text="Perteneces a más de una ubicación." />

        <!-- tab_a / tab_b: MainActivity marca la sede tocada -->
        <LinearLayout
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Button
            android:id="@+id/next"
            style="@style/Btn.Primary"
            android:layout_marginTop="24dp"
            android:text="Continuar" />
    </LinearLayout>
</ScrollView>
