<?xml version="1.0" encoding="utf-8"?>
<!-- 25. Nuevo empleado -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Screen">

    <LinearLayout style="@style/Content">

        <include layout="@layout/part_back" />

        <TextView
            style="@style/Txt.Title"
            android:text="Nuevo empleado" />

        <TextView style="@style/Txt.Label" android:text="Nombre completo" />
        <EditText style="@style/Field" android:id="@+id/name" android:hint="Escribe el nombre" android:inputType="textPersonName" />

        <TextView style="@style/Txt.Label" android:text="Documento de identidad" />
        <EditText style="@style/Field" android:id="@+id/document" android:hint="Número de documento" android:inputType="number" />

        <TextView style="@style/Txt.Label" android:text="Correo electrónico" />
        <EditText style="@style/Field" android:id="@+id/email" android:hint="correo@empresa.com" android:inputType="textEmailAddress" />

        <TextView style="@style/Txt.Label" android:text="Cargo" />
        <EditText android:id="@+id/position" style="@style/Field" android:hint="Escribe el cargo" android:inputType="textCapSentences" />

        <TextView style="@style/Txt.Label" android:text="Sede" />
        <TextView style="@style/Select" android:id="@+id/sede_select" android:hint="Seleccionar sede" />

        <LinearLayout
            style="@style/Card"
            android:layout_marginTop="12dp">

            <TextView
                style="@style/Txt.Small"
                android:text="El empleado recibirá un correo para activar su acceso."
                android:textColor="@color/link" />
        </LinearLayout>

        <Button
            android:id="@+id/save"
            style="@style/Btn.Primary"
            android:layout_marginTop="20dp"
            android:text="Guardar empleado" />
    </LinearLayout>
</ScrollView>
