<?xml version="1.0" encoding="utf-8"?>
<!-- 25. Nuevo empleado -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Screen">

    <LinearLayout style="@style/Content">

        <include layout="@layout/part_back" />

        <TextView
            style="@style/Txt.Title"
            android:text="Nuevo empleado" />

        <TextView style="@style/Txt.Label" android:text="Nombre completo" />
        <EditText style="@style/Field" android:hint="Escribe el nombre" android:inputType="textPersonName" />

        <TextView style="@style/Txt.Label" android:text="Documento de identidad" />
        <EditText style="@style/Field" android:hint="Número de documento" android:inputType="number" />

        <TextView style="@style/Txt.Label" android:text="Correo electrónico" />
        <EditText style="@style/Field" android:hint="correo@empresa.com" android:inputType="textEmailAddress" />

        <TextView style="@style/Txt.Label" android:text="Cargo" />
        <TextView style="@style/Select" android:text="Seleccionar cargo" android:textColor="@color/hint" />

        <TextView style="@style/Txt.Label" android:text="Sede" />
        <TextView style="@style/Select" android:text="Seleccionar sede" android:textColor="@color/hint" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_outline"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_circle"
                android:backgroundTint="@color/avatar_bg">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_camera"
                    app:tint="@color/link" />
            </FrameLayout>

            <LinearLayout
                style="@style/Col"
                android:layout_marginStart="12dp">

                <TextView style="@style/Txt" android:text="Foto del empleado" android:textSize="13sp" />
                <TextView style="@style/Txt.Small" android:text="Subir o tomar una foto" android:textColor="@color/primary" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            style="@style/Card"
            android:layout_marginTop="12dp">

            <TextView
                style="@style/Txt.Small"
                android:text="El empleado recibirá un correo para activar su acceso."
                android:textColor="@color/link" />
        </LinearLayout>

        <Button
            android:id="@+id/save"
            style="@style/Btn.Primary"
            android:layout_marginTop="20dp"
            android:text="Guardar empleado" />
    </LinearLayout>
</ScrollView>
