<?xml version="1.0" encoding="utf-8"?>
<!-- 33. Detalle de solicitud -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Screen">

    <LinearLayout style="@style/Content">

        <include layout="@layout/part_back" />

        <TextView
            style="@style/Txt.Title"
            android:text="Detalle de solicitud" />

        <TextView
            style="@style/Txt.Pill"
            android:layout_marginTop="16dp"
            android:id="@+id/status"
            android:textColor="@color/warn" />

        <TextView style="@style/Txt.Small" android:layout_marginTop="16dp" android:text="Tipo de permiso" />
        <TextView style="@style/Txt" android:id="@+id/type" />

        <TextView style="@style/Txt.Small" android:layout_marginTop="12dp" android:text="Fechas" />
        <TextView style="@style/Txt" android:id="@+id/dates" />

        <TextView style="@style/Txt.Small" android:layout_marginTop="12dp" android:text="Motivo" />
        <TextView style="@style/Txt" android:id="@+id/reason" />

        <TextView
            style="@style/Txt.Medium"
            android:layout_marginTop="20dp"
            android:text="Seguimiento" />

        <TextView style="@style/Txt.Sub" android:layout_marginTop="6dp" android:id="@+id/sent_line" />
        <TextView style="@style/Txt.Sub" android:layout_marginTop="6dp" android:id="@+id/review_line" />

        <Button
            android:id="@+id/cancel"
            style="@style/Btn.Secondary"
            android:layout_marginTop="28dp"
            android:text="Cancelar solicitud"
            android:textColor="@color/bad" />
    </LinearLayout>
</ScrollView>
