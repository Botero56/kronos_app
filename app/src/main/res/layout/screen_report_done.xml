<?xml version="1.0" encoding="utf-8"?>
<!-- 29. Reporte generado -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Screen">

    <LinearLayout style="@style/Content">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <include layout="@layout/part_back" />

            <ImageButton
                android:id="@+id/home"
                style="@style/IconBtn"
                android:layout_gravity="end"
                android:layout_marginEnd="-10dp"
                android:contentDescription="Inicio"
                android:src="@drawable/ic_home"
                app:tint="@color/ink" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="40dp"
            android:background="@drawable/bg_circle"
            android:backgroundTint="@color/ok_bg">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_check"
                app:tint="@color/ink" />
        </FrameLayout>

        <TextView
            style="@style/Txt.Medium"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:text="Reporte generado"
            android:textColor="@color/muted"
            android:textSize="16sp" />

        <LinearLayout
            style="@style/Card"
            android:layout_marginTop="24dp">

            <TextView
                style="@style/Txt.Medium"
                android:text="Asistencia_1-7_sep_2026.pdf"
                android:textSize="13sp" />

            <TextView
                style="@style/Txt.Small"
                android:layout_marginTop="4dp"
                android:text="156 KB · Generado hace instantes"
                android:textSize="11sp" />
        </LinearLayout>

        <Button
            android:id="@+id/download"
            style="@style/Btn.Secondary"
            android:layout_marginTop="16dp"
            android:text="Descargar"
            app:icon="@drawable/ic_download" />

        <Button
            android:id="@+id/share"
            style="@style/Btn.Secondary"
            android:layout_marginTop="12dp"
            android:text="Compartir"
            app:icon="@drawable/ic_share" />
    </LinearLayout>
</ScrollView>
