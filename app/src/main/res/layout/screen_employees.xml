<?xml version="1.0" encoding="utf-8"?>
<!-- 21. Lista de empleados -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical">

    <ScrollView
        style="@style/Screen"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout style="@style/Content">

            <TextView
                style="@style/Txt.Title"
                android:layout_marginTop="8dp"
                android:text="Empleados" />

            <EditText
                style="@style/Field"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:id="@+id/search" android:hint="Buscar empleado..." />

            <LinearLayout
                android:id="@+id/list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <Button
                android:id="@+id/add"
                style="@style/Btn.Primary"
                android:layout_marginTop="20dp"
                android:text="+ Agregar empleado" />
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/part_admin_bar" />
</LinearLayout>
