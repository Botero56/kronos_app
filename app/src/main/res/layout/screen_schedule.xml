<?xml version="1.0" encoding="utf-8"?>
<!-- 30. Mi horario / turno -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Screen">

    <LinearLayout style="@style/Content">

        <include layout="@layout/part_back" />

        <TextView
            style="@style/Txt.Title"
            android:text="Mi horario" />

        <TextView
            style="@style/Txt.Sub"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="8dp"
            android:id="@+id/schedule_sede" />

        <LinearLayout
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <LinearLayout
            style="@style/Card"
            android:layout_marginTop="16dp">

            <TextView
                style="@style/Txt.Sub"
                android:id="@+id/tolerance" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
