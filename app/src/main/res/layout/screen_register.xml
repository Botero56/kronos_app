<?xml version="1.0" encoding="utf-8"?>
<!-- 3. Registro de cuenta -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Screen">

    <LinearLayout
        style="@style/Content"
        android:paddingTop="55dp">

        <TextView
            style="@style/Txt.Title"
            android:layout_gravity="center_horizontal"
            android:text="Crear cuenta" />

        <TextView
            style="@style/Txt.Sub"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:text="Registra tu empresa en Kronos." />

        <TextView
            style="@style/Txt.Label"
            android:layout_marginTop="40dp"
            android:text="Nombre completo" />

        <EditText
            style="@style/Field"
            android:hint="Camila Restrepo"
            android:inputType="textPersonName" />

        <TextView
            style="@style/Txt.Label"
            android:text="Correo electrónico" />

        <EditText
            style="@style/Field"
            android:hint="nombre@empresa.com"
            android:inputType="textEmailAddress" />

        <TextView
            style="@style/Txt.Label"
            android:text="Nombre de la empresa" />

        <EditText
            style="@style/Field"
            android:hint="Textiles Antioquia S.A.S" />

        <TextView
            style="@style/Txt.Label"
            android:text="Contraseña" />

        <EditText
            style="@style/Field"
            android:hint="Contraseña"
            android:inputType="textPassword" />

        <CheckBox
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Acepto los términos y la política de privacidad"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <Button
            android:id="@+id/create"
            style="@style/Btn.Primary"
            android:layout_marginTop="16dp"
            android:text="Crear cuenta" />
    </LinearLayout>
</ScrollView>
