<?xml version="1.0" encoding="utf-8"?>
<!-- NUEVA: Compartir reporte -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Screen">

    <LinearLayout style="@style/Content">

        <include layout="@layout/part_back" />

        <TextView
            style="@style/Txt.Title"
            android:text="Compartir reporte" />

        <LinearLayout
            style="@style/Card"
            android:layout_marginTop="16dp">

            <TextView
                style="@style/Txt.Medium"
                android:text="Asistencia_1-7_sep_2026.pdf"
                android:textSize="13sp" />

            <TextView
                style="@style/Txt.Small"
                android:layout_marginTop="4dp"
                android:text="156 KB · PDF"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            style="@style/Txt.Label"
            android:text="Enviar a" />

        <EditText
            style="@style/Field"
            android:hint="correo@empresa.com"
            android:inputType="textEmailAddress" />

        <TextView
            style="@style/Txt.Label"
            android:text="Mensaje (opcional)" />

        <EditText
            style="@style/Field"
            android:layout_height="88dp"
            android:gravity="top"
            android:hint="Adjunto el reporte de asistencia de la semana."
            android:inputType="textMultiLine"
            android:paddingVertical="12dp" />

        <TextView
            style="@style/Txt.Label"
            android:layout_marginTop="20dp"
            android:text="Compartir por" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                style="@style/Tab"
                android:layout_height="80dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_mail"
                    app:tint="@color/muted" />

                <TextView
                    style="@style/Txt.Sub"
                    android:layout_marginTop="8dp"
                    android:text="Correo"
                    android:textSize="12sp" />
            </LinearLayout>

            <Space
                android:layout_width="12dp"
                android:layout_height="0dp" />

            <LinearLayout
                style="@style/Tab"
                android:layout_height="80dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chat"
                    app:tint="@color/muted" />

                <TextView
                    style="@style/Txt.Sub"
                    android:layout_marginTop="8dp"
                    android:text="WhatsApp"
                    android:textSize="12sp" />
            </LinearLayout>

            <Space
                android:layout_width="12dp"
                android:layout_height="0dp" />

            <LinearLayout
                style="@style/Tab"
                android:layout_height="80dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_link"
                    app:tint="@color/muted" />

                <TextView
                    style="@style/Txt.Sub"
                    android:layout_marginTop="8dp"
                    android:text="Copiar enlace"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/send"
            style="@style/Btn.Primary"
            android:layout_marginTop="24dp"
            android:text="Enviar reporte" />
    </LinearLayout>
</ScrollView>
