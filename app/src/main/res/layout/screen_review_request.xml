<?xml version="1.0" encoding="utf-8"?>
<!-- 28. Revisar solicitud (admin) -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Screen">

    <LinearLayout style="@style/Content">

        <include layout="@layout/part_back" />

        <TextView
            style="@style/Txt.Title"
            android:text="Revisar solicitud" />

        <TextView
            style="@style/Txt.Pill"
            android:layout_marginTop="16dp"
            android:id="@+id/status"
            android:textColor="@color/warn" />

        <TextView style="@style/Txt.Small" android:layout_marginTop="16dp" android:text="Empleado" />
        <TextView style="@style/Txt" android:id="@+id/employee" />

        <TextView style="@style/Txt.Small" android:layout_marginTop="12dp" android:text="Tipo de permiso" />
        <TextView style="@style/Txt" android:id="@+id/type" />

        <TextView style="@style/Txt.Small" android:layout_marginTop="12dp" android:text="Fecha" />
        <TextView style="@style/Txt" android:id="@+id/dates" />

        <TextView style="@style/Txt.Small" android:layout_marginTop="12dp" android:text="Motivo" />
        <TextView style="@style/Txt" android:id="@+id/reason" />

        <TextView
            style="@style/Txt.Medium"
            android:layout_marginTop="20dp"
            android:text="Seguimiento" />

        <TextView style="@style/Txt.Sub" android:layout_marginTop="6dp" android:id="@+id/sent_line" />
        <TextView style="@style/Txt.Sub" android:layout_marginTop="6dp" android:id="@+id/review_line" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/reject"
                style="@style/Btn.Secondary"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="Rechazar"
                android:textColor="@color/bad" />

            <Space
                android:layout_width="12dp"
                android:layout_height="0dp" />

            <Button
                android:id="@+id/approve"
                style="@style/Btn.Primary"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="Aprobar" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
