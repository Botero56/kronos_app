<?xml version="1.0" encoding="utf-8"?>
<!-- 28. Revisar solicitud (admin) -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Screen">

    <LinearLayout style="@style/Content">

        <include layout="@layout/part_back" />

        <TextView
            style="@style/Txt.Title"
            android:text="Revisar solicitud" />

        <TextView
            style="@style/Txt.Pill"
            android:layout_marginTop="16dp"
            android:text="Pendiente de revisión"
            android:textColor="@color/warn" />

        <TextView style="@style/Txt.Small" android:layout_marginTop="16dp" android:text="Empleado" />
        <TextView style="@style/Txt" android:text="Juan Pérez · Operario · Sede Bello" />

        <TextView style="@style/Txt.Small" android:layout_marginTop="12dp" android:text="Tipo de permiso" />
        <TextView style="@style/Txt" android:text="Cita médica" />

        <TextView style="@style/Txt.Small" android:layout_marginTop="12dp" android:text="Fecha" />
        <TextView style="@style/Txt" android:text="12 sep 2026" />

        <TextView style="@style/Txt.Small" android:layout_marginTop="12dp" android:text="Motivo" />
        <TextView style="@style/Txt" android:text="Cita médica en horas de la mañana en la EPS para chequeo general." />

        <TextView
            style="@style/Txt.Medium"
            android:layout_marginTop="20dp"
            android:text="Seguimiento" />

        <TextView style="@style/Txt.Sub" android:layout_marginTop="6dp" android:text="● Solicitud enviada — 8 sep, 10:20 a.m." />
        <TextView style="@style/Txt.Sub" android:layout_marginTop="6dp" android:text="○ En revisión por el administrador" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/reject"
                style="@style/Btn.Secondary"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="Rechazar"
                android:textColor="@color/bad" />

            <Space
                android:layout_width="12dp"
                android:layout_height="0dp" />

            <Button
                android:id="@+id/approve"
                style="@style/Btn.Primary"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="Aprobar" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
