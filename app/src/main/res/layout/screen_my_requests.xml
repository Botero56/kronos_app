<?xml version="1.0" encoding="utf-8"?>
<!-- 32. Mis solicitudes de permiso -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Screen">

    <LinearLayout style="@style/Content">

        <include layout="@layout/part_back" />

        <TextView
            style="@style/Txt.Title"
            android:layout_marginBottom="12dp"
            android:text="Mis solicitudes" />

        <LinearLayout
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Button
            android:id="@+id/new_request"
            style="@style/Btn.Secondary"
            android:layout_marginTop="20dp"
            android:text="+ Nueva solicitud" />
    </LinearLayout>
</ScrollView>
