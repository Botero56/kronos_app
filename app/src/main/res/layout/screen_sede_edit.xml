<?xml version="1.0" encoding="utf-8"?>
<!-- 22. Crear / editar sede -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Screen">

    <LinearLayout style="@style/Content">

        <include layout="@layout/part_back" />

        <TextView
            style="@style/Txt.Title"
            android:id="@+id/title" android:text="Nueva sede" />

        <TextView
            android:id="@+id/sede_picker"
            style="@style/Select"
            android:layout_marginTop="12dp"
            android:text="Crear una sede nueva" />

        <TextView
            style="@style/Txt.Label"
            android:text="Nombre de la sede" />

        <EditText
            style="@style/Field"
            android:id="@+id/sede_name" android:hint="Nombre de la sede" />

        <TextView
            style="@style/Txt.Label"
            android:text="Dirección" />

        <EditText
            style="@style/Field"
            android:id="@+id/sede_address" android:hint="Dirección" />

        <TextView
            style="@style/Txt.Label"
            android:text="Ubicación y radio autorizado" />

        <TextView
            android:id="@+id/coordinates"
            style="@style/Txt.Small"
            android:text="Sin ubicación. Ve a la sede y toca el botón." />

        <Button
            android:id="@+id/use_location"
            style="@style/Btn.Secondary"
            android:layout_marginTop="8dp"
            android:text="Usar mi ubicación actual" />

        <TextView style="@style/Txt.Label" android:text="Radio autorizado (metros)" />
        <EditText android:id="@+id/radius" style="@style/Field" android:hint="150" android:inputType="number" />

        <TextView style="@style/Txt.Label" android:text="Hora de entrada (HH:mm)" />
        <EditText android:id="@+id/start_time" style="@style/Field" android:hint="07:30" android:inputType="time" />

        <TextView style="@style/Txt.Label" android:text="Hora de salida (HH:mm)" />
        <EditText android:id="@+id/end_time" style="@style/Field" android:hint="17:00" android:inputType="time" />

        <Button
            android:id="@+id/save"
            style="@style/Btn.Primary"
            android:layout_marginTop="24dp"
            android:text="Guardar sede" />
    </LinearLayout>
</ScrollView>
