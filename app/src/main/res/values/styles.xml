<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Contenedores -->
    <style name="Screen">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">@color/white</item>
        <item name="android:fillViewport">true</item>
    </style>
    <style name="Content">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">24dp</item>
    </style>
    <style name="Card">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">16dp</item>
    </style>
    <style name="Divider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/line</item>
    </style>
    <!-- Fila de lista: contenido a la izquierda, valor a la derecha -->
    <style name="Row">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>
    <style name="Col">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
    </style>

    <!-- Texto -->
    <style name="Txt">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="Txt.Title">
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="Txt.TitleBar">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="Txt.Medium">
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="Txt.Sub">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/muted</item>
    </style>
    <style name="Txt.Small">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/hint</item>
    </style>
    <style name="Txt.Label">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:layout_marginBottom">6dp</item>
    </style>
    <style name="Txt.Link">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>
    <!-- Valor alineado a la derecha dentro de una fila -->
    <style name="Txt.End">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">end</item>
        <item name="android:textSize">13sp</item>
    </style>
    <style name="Txt.Fill">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
    </style>
    <style name="Txt.Badge">
        <item name="android:layout_width">56dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_gravity">center_horizontal</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:background">@drawable/bg_circle</item>
    </style>
    <style name="Txt.Avatar">
        <item name="android:layout_width">32dp</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/link</item>
        <item name="android:background">@drawable/bg_circle</item>
        <item name="android:backgroundTint">@color/avatar_bg</item>
        <item name="android:layout_marginEnd">12dp</item>
    </style>
    <style name="Txt.Pill">
        <item name="android:textSize">12sp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:background">@drawable/bg_pill</item>
    </style>

    <!-- Campos -->
    <style name="Field">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:background">@drawable/bg_field</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textColorHint">@color/hint</item>
        <item name="android:inputType">text</item>
    </style>
    <!-- Campo tipo selector (solo visual) -->
    <style name="Select" parent="Txt">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">@drawable/bg_field</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:drawableEnd">@drawable/ic_chevron_down</item>
    </style>

    <!-- Botones -->
    <style name="Btn.Primary" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">@color/primary</item>
        <item name="cornerRadius">10dp</item>
    </style>
    <style name="Btn.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/ink</item>
        <item name="backgroundTint">@color/white</item>
        <item name="strokeColor">@color/line</item>
        <item name="iconTint">@color/ink</item>
        <item name="iconGravity">textStart</item>
        <item name="cornerRadius">10dp</item>
    </style>
    <style name="IconBtn">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:scaleType">center</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
    </style>
    <!-- Pestaña de método de verificación -->
    <style name="Tab">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">89dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/bg_outline</item>
    </style>
    <!-- Ítem de la barra inferior del administrador -->
    <style name="NavItem" parent="Txt">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:drawablePadding">2dp</item>
        <item name="drawableTint">@color/muted</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>
    <style name="NavItem.Selected">
        <item name="android:textColor">@color/primary</item>
        <item name="drawableTint">@color/primary</item>
    </style>
</resources>
